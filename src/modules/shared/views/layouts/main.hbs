<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Serial Interface</title>

    {{!-- CSS --}}
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded"/>
    
    {{!-- Flash Message --}}
    <script type="module" src="/js/utils/flash-message.js"></script>
</head>

<body>

    <div class="grid grid-rows-[5rem_1fr] size-full">
        <header>
            {{>header}}
        </header>


        <main class="min-h-0 overflow-hidden">{{{body}}}</main>

        <div id="popover"
            class="hidden fixed text-[0.7em] rounded-xl border-2 border-border bg-background z-[9999]">
            <div class="move-button py-2 px-6 hover:bg-surface-3">
                <button>Mover para</button>
            </div>
            <div class="edit-button py-2 px-6 hover:bg-surface-3">
                <button>Editar</button>
            </div>
            <div class="delete-button py-2 px-6 hover:bg-surface-3">
                <button>Excluir</button>
            </div>
        </div>
    </div>

    {{!-- Biblioteca do Socket.IO --}}
    <script src="/socket.io/socket.io.js"></script>
    
    {{!-- Importa JS da página --}}
    {{#each js}} <script type="module" src="/js/{{this}}.js"></script> {{/each}}
    
</body>
</html>