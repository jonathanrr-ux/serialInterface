<div class="relative flex w-full justify-center items-center">
    <div class="font-bold">
        <p>Serial Interface</p>
        <p class="text-center text-[0.6em] text-text-secondary">
            Comunicação Serial
        </p>
    </div>

    {{#unless hide}}
        <div id="serial-connection-button" data-connected="{{system.serial.connected}}" class="group absolute right-0">
            <button class="group-data-[connected=true]:block hidden rounded-md p-2 text-[0.7em] font-bold bg-success hover:bg-success-hover ">
                Conectado
            </button>
            <button class="group-data-[connected=false]:block hidden rounded-md p-2 text-[0.7em] font-bold bg-danger hover:bg-danger-hover">
                Desconectado
            </button>
        </div>
    {{/unless}}

</div>