<section class="flex h-full min-h-0 items-center justify-center gap-3 p-8">
    {{!-- Lateral esquerda --}}
    <div class="flex flex-col h-full min-h-0 w-[23%] p-4 card gap-2">
        {{!-- Título --}}
        <div class="flex justify-between items-center w-full p-2">
            <div class="flex font-bold gap-2">
                <img src="/img/icons/folder.svg" class="size-[2rem] drop-shadow-[0_0_8px_rgba(99,102,241,0.6)]">
                Templates
            </div>

            {{!-- Botões --}}
            <button class="size-[2.5rem]">
                <img src="/img/icons/add.svg" class="base-button primary size-full">
            </button>
        </div>

        {{!-- Borda --}}
        <hr class="w-full text-border">


        {{!-- Search --}}
        <div class="relative w-full h-[3rem] 2xl:h-[3.5rem]">
            <input id="search-bar" placeholder="Busque o template" class="input size-full !pl-10">
            <img src="/img/icons/search.svg" class="absolute top-[50%] -translate-y-1/2 left-2">
        </div>

        {{!-- Botão --}}
        <div class="flex justify-end w-full">
            <button id="delete-all-templates" class="lg:w-[5rem] xl:w-[8rem] 2xl:w-[10rem] h-[2.5rem] rounded-md text-[0.8em] font-bold base-button danger">Excluir todos</button>
        </div>

        <hr class="w-full text-border">

        {{!-- Itens --}}
        <div id="templates-list" class="flex-1 min-h-0 flex flex-col gap-4 overflow-y-auto">
        </div>
    </div>

    {{!-- Centro --}}
    <div class="h-full min-h-0 w-[43%] p-4 card">
        {{!-- Wrapper --}}
        <div class="hidden flex-col h-full min-h-0 justify-between">
            {{!-- Título --}}
            <div class="flex justify-between items-center w-full">
                <div class="flex font-bold gap-3">
                    <img src="/img/icons/packet.svg" class="size-[2rem] drop-shadow-[0_0_8px_rgba(99,102,241,0.6)]">
                    Editor de pacotes
                </div>
                <details class="relative inline-block z-10">
                    <summary class="base-button primary flex items-center gap-2 p-2 text-text font-bold text-[0.8em]">
                        <img src="/img/icons/add.svg" class="size-[2rem]">
                        Novo pacote
                    </summary>

                    <!-- Menu pop hover -->
                    <div class="flex flex-col absolute right-0 mt-2 w-[20rem] rounded-lg border-2 border-border bg-surface p-4 gap-2">
                        <!-- Conteúdo -->
                        <p class="">Quantidade de bytes</p>
                        <input id="bytes-quantity-input" type="number" min="1" max="9" value="9" class="w-full rounded border-2 p-2 outline-none border-border bg-background focus:border-primary">
                        
                        <hr class="text-border">
                        <button id="create-new-packet-button" class="disabled:opacity-30 py-2 rounded-md bg-primary hover:bg-primary-hover font-bold">Criar</button>
                    </div>
                </details>
            </div>

            <hr class="text-border w-full my-3">

            {{!-- Lista de bytes --}}
            <div id="packet-list" class="flex flex-col w-full flex-1 min-h-0 overflow-y-auto gap-3 font-mono">
            </div>

            <!-- Botão -->
            <div class="flex w-full justify-between">
                <button
                    id="add-new-template-button"
                    commandfor="template-modal" 
                    command="show-modal"
                    class="w-[48%] disabled:opacity-30 rounded-lg px-6 py-3 font-semibold transition bg-success hover:bg-success-hover"
                >
                    Salvar template
                </button>

                <button id="send-all-button" class="w-[48%] disabled:opacity-30 rounded-lg px-6 py-3 font-semibold transition bg-primary hover:bg-primary-hover">
                    Enviar todos
                </button>
            </div>
        </div>
    </div>

    {{!-- Lateral direita --}}
    <div class="flex flex-col flex-1 h-full min-h-0 card overflow-hidden">
        <div class="flex w-full items-center justify-between p-4">
            <div class="flex font-bold gap-3">
                <img src="/img/icons/list.svg" class="size-[2rem] drop-shadow-[0_0_8px_rgba(99,102,241,0.6)]">
                Logs
            </div>
            <button id="clear-all-logs-button" class="flex h-[3rem] base-button rounded-xl p-2 gap-2">
                <img src="/img/icons/trash.svg" class="">
                Limpar
            </button>
        </div>

        <div class="flex w-full justify-evenly text-[0.8em]">
            <button class="rounded-xl py-1 px-5 font-bold text-primary bg-linear-to-b from-primary/30 to-primary/10 shadow-[0_8px_24px_rgba(0,0,0,.35),inset_rgba(255,255,255,.05)_1px_1px_1px] hover:shadow-[0_5px_15px_rgba(99,102,241,0.3)]">Enviado</button>
            <button class="rounded-xl py-1 px-5 font-bold text-success bg-linear-to-b from-success/30 to-success/10 shadow-[0_8px_24px_rgba(0,0,0,.35),inset_rgba(255,255,255,.05)_1px_1px_1px] hover:shadow-[0_5px_15px_rgba(34,197,94,0.3)]">Recebido</button>
            <button class="rounded-xl py-1 px-5 font-bold text-danger bg-linear-to-b from-danger/30 to-danger/10 shadow-[0_8px_24px_rgba(0,0,0,.35),inset_rgba(255,255,255,.05)_1px_1px_1px] hover:shadow-[0_5px_15px_rgba(239,68,68,0.3)]">Erro</button>
        </div>

        <hr class="text-border mt-4">

        <div id="logs-list" class="h-full min-h-0 font-mono text-[0.7em] overflow-y-auto bg-background p-4">
        </div>
    </div>

    {{!-- Modal --}}
    <dialog id="template-modal" class="m-auto w-[32rem] rounded-xl border-2 border-border bg-surface p-0 text-text backdrop:bg-black/50">

        {{!-- Cabeçalho --}}
        <div class="border-b-2 border-border p-5">
            <p class="font-bold">Salvar template</p>
            <p class="mt-1 text-[0.7em] text-text-secondary">Escolha como deseja salvar este pacote.</p>
        </div>

        {{!-- Conteúdo --}}
        <div data-template="new-template" class="group flex flex-col gap-5 p-5">
            <label class="flex items-center gap-2">
                <input type="radio" value="new-template" name="template-type" checked>
                Novo template
            </label>

            <label class="flex items-center gap-2">
                <input type="radio" value="exist-template" name="template-type">
                Adicionar a um template existente
            </label>

            {{!-- Input de nome --}}
            <div class="group-data-[template=new-template]:flex hidden flex-col gap-2">
                <p class="text-[0.7em] text-text-secondary">Nome</p>
                <input id="template-name-input" type="text" placeholder="Ex.: Abrir gaveta" class="h-[3rem] rounded-lg border-2 border-border bg-background p-2 outline-none focus:border-primary">
            </div>

            {{!-- Select --}}
            <div class="group-data-[template=exist-template]:flex hidden flex-col w-[50%] gap-2">
                <p class="text-[0.7em] text-text-secondary">Template</p>
                <div aria-disabled="false" class="relative w-full h-[3rem] aria-disabled:opacity-50 aria-disabled:pointer-events-none" id="select-template"></div>
            </div>
        </div>

        {{!-- Rodapé --}}
        <div class="flex justify-end gap-3 border-t-2 border-border p-5">
            <button
                commandfor="template-modal"
                command="close"
                class="rounded-lg border-2 border-border px-5 py-2 hover:bg-surface-light">
                Cancelar
            </button>

            <button 
                commandfor="template-modal"
                command="close"
                id="save-template-button" class="rounded-lg bg-success px-5 py-2 font-bold hover:bg-success-hover">
                Salvar
            </button>

        </div>

    </dialog>
</section>

<script type="module" src="/js/interface/template.js"></script>
<script type="module" src="/js/interface/logs.js"></script>