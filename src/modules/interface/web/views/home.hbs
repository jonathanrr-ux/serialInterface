<section class="flex h-full min-h-0 items-center justify-center gap-3 p-8">
    {{!-- Lateral esquerda --}}
    <div class="flex flex-col h-full min-h-0 w-[23%] p-4 card gap-2">
        {{!-- Título --}}
        <div class="flex justify-between items-center w-full p-2">
            <div class="flex font-bold gap-2">
                <img src="/img/icons/folder.svg" class="size-[2rem] drop-shadow-[0_0_8px_rgba(99,102,241,0.6)]">
                Templates
            </div>

            {{!-- Botões --}}
            <button commandfor="template-modal" command="show-modal" id="add-new-template" class="size-[2.5rem]">
                <img src="/img/icons/add.svg" class="base-button primary size-full">
            </button>
        </div>

        {{!-- Borda --}}
        <hr class="w-full text-border">


        {{!-- Search --}}
        <div class="relative w-full h-[3rem] 2xl:h-[3.5rem]">
            <input id="search-bar" placeholder="Busque o template" class="input size-full !pl-10">
            <img src="/img/icons/search.svg" class="absolute top-[50%] -translate-y-1/2 left-2">
        </div>

        {{!-- Botão --}}
        <div class="flex justify-end w-full">
            <button id="delete-all-templates" class="lg:w-[5rem] xl:w-[8rem] 2xl:w-[10rem] h-[2.5rem] rounded-md text-[0.8em] font-bold base-button danger">Excluir todos</button>
        </div>

        {{!-- Itens --}}
        <div class="flex-1 min-h-0 flex flex-col overflow-y-auto">
            <div id="groups-list" class="flex flex-col flex-1 bg-background-2 rounded-xl p-3 gap-5">
            </div>

            <hr class="w-full text-border">
            <button 
                commandfor="group-modal" 
                command="show-modal" 
                id="add-new-group-button" 
                class="flex w-full justify-center bg-background-2 py-2 gap-2 text-primary [text-shadow:0_0_8px_var(--color-primary)] 
                    cursor-pointer hover:bg-surface-2 rounded-b-xl
            ">
                <img src="/img/icons/add.svg" class="filter-[var(--filter-primary)]">
                Adicionar grupo
            </button>
        </div>
    </div>

    {{!-- Centro --}}
    <div id="package-editor-container" data-active="false" data-active-tab="templates" class="group flex flex-col h-full min-h-0 w-[45%] card">
        {{!-- Tabs --}}
        <div class="flex w-full border-b-2 border-border">
            <button 
                aria-selected="false" 
                data-tab="packets"
                class="group-data-[active=true]:flex hidden items-center gap-2 px-10 py-4 text-text font-bold 
                    transition-all border-b-2 border-transparent -mb-0.5 aria-selected:[text-shadow:0_0_8px_var(--color-primary)]  
                    aria-selected:border-b-2  aria-selected:border-primary  aria-selected:bg-primary/5 hover:[text-shadow:0_0_8px_var(--color-primary)] 
                    hover:border-primary" 
            >
                <img src="/img/icons/packet.svg" class="size-5">
                Pacotes
            </button>

            <button 
                aria-selected="false" 
                data-tab="rules"
                class="group-data-[active=true]:flex hidden items-center gap-2 px-10 py-4 -mb-0.5 border-b-2 aria-selected:border-b-2 font-bold 
                    transition-all border-transparent aria-selected:border-primary hover:border-primary aria-selected:bg-primary/5 
                    hover:[text-shadow:0_0_8px_var(--color-primary)] aria-selected:[text-shadow:0_0_8px_var(--color-primary)]" 
                
            >
                <img src="/img/icons/rule.svg" class="size-5">
                Regras
            </button>

            <button 
                aria-selected="true" 
                data-tab="groups"
                class="flex items-center gap-2 px-10 py-4 -mb-0.5 border-b-2 aria-selected:border-b-2 font-bold 
                    transition-all border-transparent aria-selected:border-primary hover:border-primary aria-selected:bg-primary/5 
                    hover:[text-shadow:0_0_8px_var(--color-primary)] aria-selected:[text-shadow:0_0_8px_var(--color-primary)]" 
                
            >
                <img src="/img/icons/rule.svg" class="size-5">
                Grupos
            </button>
        </div>

        {{!-- Rules --}}
        <div class="group-data-[active-tab=rules]:group-data-[active=true]:flex flex-col h-full min-h-0 hidden p-4">
            {{!-- Título --}}
            <div class="flex justify-between items-center w-full p-4">
                <div class="flex flex-col font-bold gap-3">
                    Motor de regras
                    <p class="text-[0.7em] text-text-secondary font-normal">Defina ações automáticas baseadas nos dados recebidos</p>
                </div>
                <button id="new-rule-button" class="base-button primary flex items-center gap-2 p-2 text-text font-bold text-[0.8em]">
                    <img src="/img/icons/add.svg" class="size-[2rem]">
                    Nova regra
                </button>
            </div>
            <hr class="text-border w-full mt-2">

            {{!-- Lista de regras --}}
            <div id="rule-list" class="flex flex-col gap-4 p-4 overflow-y-auto flex-1 min-h-0">
            </div>

            <div id="save-new-rule-button" class="border-t-2 border-border flex justify-end pt-2">
                <button class="base-button success rounded-xl px-6 py-3">
                    Salvar regras
                </button>
            </div>
        </div>

        {{!-- Packets --}}
        <div class="group-data-[active-tab=packets]:group-data-[active=true]:flex flex-1 hidden flex-col h-full min-h-0 p-4">
            {{!-- Título --}}
            <div class="flex justify-between items-center w-full">
                <div class="flex flex-col font-bold gap-3 p-4">
                    Editor de pacotes
                    <p class="text-[0.7em] text-text-secondary font-normal">Monte pacotes de dados para transmissão serial</p>
                </div>
                <details class="relative inline-block z-10">
                    <summary class="base-button primary flex items-center gap-2 p-2 text-text font-bold text-[0.8em]">
                        <img src="/img/icons/add.svg" class="size-[2rem]">
                        Novo pacote
                    </summary>

                    <!-- Menu pop hover -->
                    <div class="flex flex-col absolute right-0 mt-2 w-[20rem] rounded-lg border-2 border-border bg-surface p-4 gap-2">
                        <!-- Conteúdo -->
                        <p class="">Quantidade de bytes</p>
                        <input id="bytes-quantity-input" type="number" min="1" max="9" value="9" maxlength="1" class="input w-full">

                        <hr class="text-border">
                        <button id="create-new-packet-button" type="button" class="base-button primary disabled:opacity-30 py-2 rounded-xl">Criar</button>
                    </div>
                </details>
            </div>

            <hr class="text-border w-full mt-2">

            {{!-- Lista de bytes --}}
            <div class="flex flex-col flex-1 min-h-0">
                <div id="packet-list" class="flex flex-col flex-1 min-h-0 overflow-y-auto gap-3 font-mono">
                </div>

                <!-- Botão -->
                <div class="flex w-full justify-between border-t-2 border-border pt-2">
                    <button id="save-template-button" class="w-[48%] disabled:opacity-30 px-6 py-3 base-button success rounded-xl">
                        Salvar template
                    </button>
                    <button id="send-all-button" class="w-[48%] disabled:opacity-30 rounded-xl px-6 py-3 base-button primary">
                        Enviar todos
                    </button>
                </div>
            </div>
        </div>

        {{!-- Templates --}}
        <div class="group-data-[active-tab=groups]:flex flex-col h-full min-h-0 hidden p-4 gap-4 overflow-y-auto">
            {{!-- Lista de regras --}}
            <div id="groups-tab-list" class="grid grid-cols-2 gap-3">
            </div>
        </div>
    </div>

    {{!-- Lateral direita --}}
    <div class="flex flex-col flex-1 items-center h-full min-h-0 card overflow-hidden">
        <div class="flex w-full items-center justify-between p-4">
            <div class="flex font-bold gap-3">
                <img src="/img/icons/list.svg" class="size-[2rem] drop-shadow-[0_0_8px_rgba(99,102,241,0.6)]">
                Logs
            </div>
            <div class="flex justify-between bg-surface-light border-2 border-border font-bold rounded-md">
                <p class="self-center text-[0.8em] px-2">Tamanho da resposta:</p>
                <input id="response-input" value="{{system.settings.responseLength}}" maxlength="1" class="bg-background size-[3rem] outline-none text-center p-2 border-l-2 border-border">
            </div>
            <button id="clear-all-logs-button" class="flex h-[3rem] base-button rounded-xl p-2 gap-2">
                <img src="/img/icons/trash.svg" class="">
                Limpar
            </button>
        </div>

        <div id="filter-logs-buttons" class="flex flex-wrap w-full justify-evenly text-[0.8em] gap-2">
            <button data-filter="tx">Enviado</button>
            <button data-filter="rx">Recebido</button>
            <button data-filter="connection">Conexão</button>
            <button data-filter="error">Erro</button>
            <button data-filter="all">Todos</button>
        </div>

        <hr class="text-border mt-4">

        <div id="logs-list" class="w-full h-full min-h-0 font-mono text-[0.7em] overflow-y-auto bg-background p-4">
        </div>
    </div>

    {{!-- Modal --}}
    <dialog id="template-modal" class="m-auto w-[32rem] rounded-xl border-2 border-border bg-surface text-text backdrop:bg-black/50 p-4">

        {{!-- Cabeçalho --}}
        <div class="border-b-2 border-border p-1">
            <p class="font-bold">Adicionar template</p>
            <p class="mt-1 text-[0.7em] text-text-secondary">Escolha como este template vai se chamar</p>
        </div>

        <div class="flex flex-col gap-2 my-4">
            <p class="text-[0.7em] text-text-secondary">Grupo<span class="text-primary">*</span></p>
            <select id="group-select" class="input">
            </select>
        </div>

        {{!-- Input de nome --}}
        <div class="flex flex-col gap-2 my-4">
            <p class="text-[0.7em] text-text-secondary">Nome<span class="text-primary">*</span></p>
            {{> input-with-error
                id="template-name-input"
                type="text"
                placeholder="Ex.: Bateria"
            }}
        </div>

        {{!-- Input de nome --}}
        <div class="flex flex-col gap-2 my-4">
            <p class="text-[0.7em] text-text-secondary">Descrição</p>
            {{> input-with-error
                id="template-description-input"
                type="text"
                placeholder="Ex.: Status da bateria"
            }}
        </div>

        {{!-- Rodapé --}}
        <div class="flex justify-end gap-3 border-t-2 border-border pt-4">
            <button
                commandfor="template-modal"
                command="close"
                class="base-button px-5 py-2 rounded-xl">
                Cancelar
            </button>

            <button 
                id="save-new-template-button" class="base-button success px-5 py-2 rounded-xl">
                Salvar
            </button>

        </div>

    </dialog>

    {{!-- Modal --}}
    <dialog id="group-modal" class="m-auto w-[32rem] rounded-xl border-2 border-border bg-surface text-text backdrop:bg-black/50 p-4">

        {{!-- Cabeçalho --}}
        <div class="border-b-2 border-border p-1">
            <p class="font-bold">Adicionar grupo</p>
            <p class="mt-1 text-[0.7em] text-text-secondary">Adicione e estilize um grupo para templates</p>
        </div>

        {{!-- Input de nome --}}
        <div class="flex flex-col gap-2 my-3">
            <p class="text-[0.7em] text-text-secondary">Pré visualização</p>
            <div class="flex items-center justify-center card w-full h-[4rem] gap-3">
                <div id="color-preview" class="size-[2.5rem] rounded-xl flex items-center justify-center">
                    <span id="icon-preview" class="material-symbols-rounded text-white text-[2rem]">
                    </span>
                </div>
                <p id="visualization-name" class="font-bold"></p>
            </div>
        </div>

        {{!-- Input de nome --}}
        <div class="flex flex-col gap-2 my-4">
            <p class="text-[0.7em] text-text-secondary">Nome<span class="text-primary">*</span></p>
            {{> input-with-error
                id="group-name-input"
                type="text"
                placeholder="Ex.: Configurações"
            }}
        </div>

        {{!-- Input de nome --}}
        <div class="flex flex-col gap-2 my-4">
            <p class="text-[0.7em] text-text-secondary">Descrição</p>
            {{> input-with-error
                id="group-description-input"
                type="text"
                placeholder="Ex.: Configurações"
            }}
        </div>

        {{!-- Ícone --}}
        <div class="flex flex-col gap-3 my-4">
            <p class="text-[0.7em] text-text-secondary">Ícone<span class="text-primary">*</span></p>

            {{!-- Categorias --}}
            <div id="category-list" class="flex gap-2 overflow-x-auto pb-1"></div>

            {{!-- Lista de ícones --}}
            <div id="icons-list" class="grid grid-cols-7 gap-2 rounded-xl border border-border bg-background-2 p-3 max-h-[14rem] overflow-y-auto"></div>
        </div>

        {{!-- Cor --}}
        <div class="flex flex-col gap-3 my-4">
            <p class="text-[0.7em] text-text-secondary">Cor<span class="text-primary">*</span></p>

            <div id="colors-list" class="grid grid-cols-6 gap-3">
                <button class="color-button aria-selected:border-white aria-selected:shadow-[0_0_12px_rgba(255,255,255,.4)]" aria-selected="true" data-color="#6366F1" style="background:#6366F1"></button>
                <button class="color-button aria-selected:border-white aria-selected:shadow-[0_0_12px_rgba(255,255,255,.4)]" aria-selected="false" data-color="#3B82F6" style="background:#3B82F6"></button>
                <button class="color-button aria-selected:border-white aria-selected:shadow-[0_0_12px_rgba(255,255,255,.4)]" aria-selected="false" data-color="#06B6D4" style="background:#06B6D4"></button>
                <button class="color-button aria-selected:border-white aria-selected:shadow-[0_0_12px_rgba(255,255,255,.4)]" aria-selected="false" data-color="#10B981" style="background:#10B981"></button>
                <button class="color-button aria-selected:border-white aria-selected:shadow-[0_0_12px_rgba(255,255,255,.4)]" aria-selected="false" data-color="#84CC16" style="background:#84CC16"></button>
                <button class="color-button aria-selected:border-white aria-selected:shadow-[0_0_12px_rgba(255,255,255,.4)]" aria-selected="false" data-color="#EAB308" style="background:#EAB308"></button>
                <button class="color-button aria-selected:border-white aria-selected:shadow-[0_0_12px_rgba(255,255,255,.4)]" aria-selected="false" data-color="#F97316" style="background:#F97316"></button>
                <button class="color-button aria-selected:border-white aria-selected:shadow-[0_0_12px_rgba(255,255,255,.4)]" aria-selected="false"data-color="#EF4444" style="background:#EF4444"></button>
                <button class="color-button aria-selected:border-white aria-selected:shadow-[0_0_12px_rgba(255,255,255,.4)]" aria-selected="false" data-color="#EC4899" style="background:#EC4899"></button>
                <button class="color-button aria-selected:border-white aria-selected:shadow-[0_0_12px_rgba(255,255,255,.4)]" aria-selected="false" data-color="#A855F7" style="background:#A855F7"></button>
                <button class="color-button aria-selected:border-white aria-selected:shadow-[0_0_12px_rgba(255,255,255,.4)]" aria-selected="false" data-color="#64748B" style="background:#64748B"></button>

                {{!-- Cor personalizada --}}
                <label id="custom-color-button" class="color-button cursor-pointer bg-surface-2 relative">
                    <span class="material-symbols-rounded text-white">palette</span>

                    <input id="custom-color" type="color" class="absolute inset-0 opacity-0 size-full cursor-pointer" value="#6366F1">
                </label>
            </div>
        </div>

        {{!-- Rodapé --}}
        <div class="flex justify-end gap-3 border-t-2 border-border pt-4">
            <button
                commandfor="group-modal"
                command="close"
                class="base-button px-5 py-2 rounded-xl">
                Cancelar
            </button>

            <button 
                id="save-group-button"
                class="base-button success px-5 py-2 rounded-xl">
                Salvar
            </button>

        </div>

    </dialog>
</section>

<script type="module" src="/js/interface/template.js"></script>
<script type="module" src="/js/interface/template-groups.js"></script>
<script type="module" src="/js/interface/rules.js"></script>
<script type="module" src="/js/interface/logs.js"></script>