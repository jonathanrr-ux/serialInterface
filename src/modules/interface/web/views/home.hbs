<section class="flex size-full items-center justify-center gap-3 p-8">
    {{!-- Lateral esquerda --}}
    <div class="flex flex-col h-full w-[25%] p-4 border-2 rounded-xl border-border bg-surface">
        {{!-- Título --}}
        <div class="flex justify-between items-center w-full">
            <p class="font-bold">Templates</p>
            <button id="delete-all-templates" class="lg:w-[5rem] xl:w-[8rem] 2xl:w-[10rem] h-[2.5rem] rounded-md text-[0.8em] font-bold bg-danger">Excluir todos</button>
        </div>

        {{!-- Borda --}}
        <hr class="w-full text-border my-2">

        <div class="relative w-full h-[3rem] 2xl:h-[3.5rem]">
            <input id="search-bar" class="size-full border-2 border-border rounded-md outline-none bg-background pl-10">
            <img src="/img/icons/search.svg" class="absolute top-[50%] -translate-y-1/2 left-2">
        </div>

        <hr class="w-full text-border my-2">

        {{!-- Itens --}}
        <div id="templates-list" class="flex flex-col lg:h-[29rem] xl:h-[30rem] 2xl:h-[40rem] gap-3 overflow-y-auto scroll-auto">
        </div>
    </div>

    {{!-- Centro --}}
    <div class="flex flex-col justify-between h-full w-[43%] p-4 border-2 rounded-xl border-border bg-surface">

        <div>
            {{!-- Título --}}
            <div class="flex justify-between items-center w-full">
                <p class="font-bold">Editor de pacotes</p>
                <div class="flex gap-3">
                    <p class="self-center text-[0.8em]">Tamanho da resposta:</p>
                    <input id="response-input" value="0" maxlength="2" class="bg-background size-[3rem] outline-none border-2 border-border text-center p-2 rounded-md">
                    <details class="relative inline-block z-10">
                        <summary class="flex items-center gap-2 rounded-md p-2 text-text font-bold text-[0.8em] bg-primary hover:bg-primary-hover">
                            <img src="/img/icons/add.svg" class="size-[2rem]">
                            Novo pacote
                        </summary>

                        <!-- Menu pop hover -->
                        <div class="flex flex-col absolute right-0 mt-2 w-[20rem] rounded-lg border-2 border-border bg-surface p-4 gap-2">
                            <!-- Conteúdo -->
                            <p class="">Quantidade de bytes</p>
                            <input id="bytes-quantity-input" type="number" min="1" max="9" value="9" class="w-full rounded border-2 p-2 outline-none border-border bg-background focus:border-primary">
                            
                            <hr class="text-border">
                            <button id="create-new-packet-button" class="disabled:opacity-30 py-2 rounded-md bg-primary hover:bg-primary-hover font-bold">Criar</button>
                        </div>
                    </details>
                </div>
            </div>

            <hr class="text-border w-full my-3">

            {{!-- Lista de bytes --}}
            <div id="packet-list" class="flex flex-col w-full lg:h-[25rem] xl:h-[29rem] 2xl:h-[39rem] overflow-y-auto gap-3 font-mono">
            </div>
            <hr class="text-border w-full my-3">
        </div>

            
        <!-- Botão -->
        <div class="flex w-full justify-between">
            <button
                id="add-new-template-button"
                commandfor="template-modal" 
                command="show-modal"
                class="w-[48%] disabled:opacity-30 rounded-lg px-6 py-3 font-semibold transition bg-success hover:bg-success-hover"
            >
                Salvar template
            </button>

            <button id="send-all-button" class="w-[48%] disabled:opacity-30 rounded-lg px-6 py-3 font-semibold transition bg-primary hover:bg-primary-hover">
                Enviar todos
            </button>
        </div>
    </div>

    {{!-- Lateral direita --}}
    <div class="flex flex-col h-full w-[35%] border-2 rounded-xl border-border bg-surface">
        <div class="flex justify-between items-center rounded-t-xl p-3 bg-surface">
            <p class="font-bold">Logs</p>
            <button id="clear-all-logs-button" class="flex h-[3rem] items-center border-2 border-border font-bold p-2 gap-2 rounded-md text-[0.8em] bg-surface-light hover:bg-surface">
                <img src="/img/icons/trash.svg" class="">
                Limpar
            </button>
        </div>

        <hr class="text-border">

        <div class="flex w-full justify-evenly my-2 text-[0.8em]">
            <button class="rounded-md border-2 border-border py-1 px-5 font-bold text-primary bg-surface/50">Enviado</button>
            <button class="rounded-md border-2 border-border py-1 px-5 font-bold text-success bg-surface/50">Recebido</button>
            <button class="rounded-md border-2 border-border py-1 px-5 font-bold text-danger bg-surface/50">Erro</button>
        </div>

        <hr class="text-border">

        <div id="logs-list" class="xl:h-[33rem] 2xl:h-[42rem] p-5 font-mono text-[0.7em] overflow-y-auto scroll-auto">
        </div>
    </div>

    {{!-- Modal --}}
    <dialog id="template-modal" class="m-auto w-[32rem] rounded-xl border-2 border-border bg-surface p-0 text-text backdrop:bg-black/50">

        {{!-- Cabeçalho --}}
        <div class="border-b-2 border-border p-5">
            <p class="font-bold">Salvar template</p>
            <p class="mt-1 text-[0.7em] text-text-secondary">Escolha como deseja salvar este pacote.</p>
        </div>

        {{!-- Conteúdo --}}
        <div data-template="new-template" class="group flex flex-col gap-5 p-5">
            <label class="flex items-center gap-2">
                <input type="radio" value="new-template" name="template-type" checked>
                Novo template
            </label>

            <label class="flex items-center gap-2">
                <input type="radio" value="exist-template" name="template-type">
                Adicionar a um template existente
            </label>

            {{!-- Input de nome --}}
            <div class="group-data-[template=new-template]:flex hidden flex-col gap-2">
                <p class="text-[0.7em] text-text-secondary">Nome</p>
                <input id="template-name-input" type="text" placeholder="Ex.: Abrir gaveta" class="h-[3rem] rounded-lg border-2 border-border bg-background p-2 outline-none focus:border-primary">
            </div>

            {{!-- Select --}}
            <div class="group-data-[template=exist-template]:flex hidden flex-col w-[50%] gap-2">
                <p class="text-[0.7em] text-text-secondary">Template</p>
                <div aria-disabled="false" class="relative w-full h-[3rem] aria-disabled:opacity-50 aria-disabled:pointer-events-none" id="select-template"></div>
            </div>
        </div>

        {{!-- Rodapé --}}
        <div class="flex justify-end gap-3 border-t-2 border-border p-5">
            <button
                commandfor="template-modal"
                command="close"
                class="rounded-lg border-2 border-border px-5 py-2 hover:bg-surface-light">
                Cancelar
            </button>

            <button 
                commandfor="template-modal"
                command="close"
                id="save-template-button" class="rounded-lg bg-success px-5 py-2 font-bold hover:bg-success-hover">
                Salvar
            </button>

        </div>

    </dialog>
</section>

<script type="module" src="/js/interface/template.js"></script>
<script type="module" src="/js/interface/logs.js"></script>