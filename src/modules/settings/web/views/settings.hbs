<section class="flex size-full items-center justify-center">
    <div class="card flex flex-col h-[70%] w-[50%] 2xl:h-[50%] 2xl:w-[30%] rounded-xl -translate-y-2 shadow-[0_35px_80px_rgba(0,0,0,0.5),0_0_40px_rgba(99,102,241,0.2)]">

        {{!--  Configuração serial --}}
        <div class="text-center border-b-2 border-border p-3">
            <p class="font-bold">Configuração Serial</p>
            <p class="text-[0.7em] text-text-secondary">Configure a conexão com o dispositivo</p>
        </div>

        {{!-- Porta serial --}}
        <div class="flex flex-col gap-2 p-3">
            <p class="font-bold">Porta Serial</p>
            <div class="w-full font-normal relative h-[3rem] aria-disabled:opacity-50 aria-disabled:pointer-events-none" id="select-serial-port"></div>
        </div>

        {{!-- Baud rate --}}
        <div class="flex flex-col gap-2 p-3">
            <p class="font-bold">Baudrate</p>
            <div class="w-full font-normal relative h-[3rem] aria-disabled:opacity-50 aria-disabled:pointer-events-none" id="select-baud-rate"></div>
        </div>

        <div class="flex items-center gap-3 p-3">
            <input id="auto-reconnect" type="checkbox" class=" size-5 appearance-none
                rounded-md border border-border bg-surface cursor-pointer transition-all duration-200
                checked:bg-primary checked:border-primary checked:shadow-[0_0_12px_rgba(99,102,241,0.45)]
                checked:after:content-['✓'] checked:after:flex checked:after:items-center checked:after:justify-center
                checked:after:text-white checked:after:font-bold checked:after:text-sm hover:border-primary
            "/>

            <label for="auto-reconnect">
                Reconectar automaticamente
            </label>
        </div>

        <div class="flex w-full mt-auto p-3">
            <button id="connect-button" class="base-button primary w-full rounded-xl p-3">
                Conectar
            </button>
        </div>
    </div>
</section>