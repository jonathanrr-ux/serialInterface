<section class="flex size-full items-center justify-center">
    <div class="flex flex-col lg:h-[70%] lg:w-[50%] 2xl:h-[50%] 2xl:w-[30%] border-2 rounded-xl border-border bg-surface">

        {{!--  Configuração serial --}}
        <div class="text-center border-b-2 border-border p-3">
            <p class="font-bold">Configuração Serial</p>
            <p class="text-[0.7em] text-text-secondary">Configure a conexão com o dispositivo</p>
        </div>

        {{!-- Porta serial --}}
        <div class="flex flex-col gap-2 p-3">
            <p class="font-bold">Porta Serial</p>
            <div class="w-full font-normal relative h-[3rem] aria-disabled:opacity-50 aria-disabled:pointer-events-none" id="select-serial-port"></div>
        </div>

        {{!-- Baud rate --}}
        <div class="flex flex-col gap-2 p-3">
            <p class="font-bold">Baudrate</p>
            <div class="w-full font-normal relative h-[3rem] aria-disabled:opacity-50 aria-disabled:pointer-events-none" id="select-baud-rate"></div>
        </div>

        <div class="flex items-center gap-3 p-3">
            <input id="auto-reconnect" type="checkbox" class="size-5"/>

            <label for="auto-reconnect">
                Reconectar automaticamente
            </label>
        </div>

        <div class="flex w-full mt-auto p-3">
            <button id="connect-button" class="w-full rounded-md bg-primary hover:bg-primary-hover font-bold p-3">
                Conectar
            </button>
        </div>
    </div>
</section>